
PRIMARY_PROVIDER=groq
PRIMARY_MODEL=llama-3.1-70b-versatile
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=your_key_here

# Groq primary, Ollama fallback (free local safety net if you
#            hit Groq rate limits). Uncomment and run `ollama serve` +
#            `ollama pull llama3.1` first:
# FALLBACK_PROVIDER=ollama
# FALLBACK_MODEL=llama3.1

#fully offline, zero API keys, zero cost. Run `ollama serve` +
#            `ollama pull llama3.1` (and optionally a smaller model for
#            fallback, e.g. `ollama pull llama3.2:3b`), then uncomment:
# PRIMARY_PROVIDER=ollama
# PRIMARY_MODEL=llama3.1
# FALLBACK_PROVIDER=ollama
# FALLBACK_MODEL=llama3.2:3b

OLLAMA_BASE_URL=http://localhost:11434

# ---- Storage ----
SQLITE_DB_PATH=./data/support.db
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
CHROMA_PERSIST_DIR=./data/chroma

# ---- Observability ----
# Free self-hosted Langfuse (from docker-compose) or free cloud.langfuse.com account
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ai-support-agent

# ---- Human escalation ----
# optional free Slack incoming webhook, leave blank to just log
ESCALATION_WEBHOOK_URL=

APP_ENV=development
LOG_LEVEL=INFO
